{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "OutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u11}] {Message:lj}{NewLine}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "Path": "logs/log-.txt",
          "RollingInterval": "Day",
          "OutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u11}] {Message:lj}{NewLine}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "sqlConnection": "Server=.;Database=ExpenseTracker;User Id=sa;Password=sysadmin123;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "validIssuer": "ExpenseTrackerAPI",
    "validAudience": "https://localhost:5000",
    "expires": 30,
    "secret": "CodeMazeSecretKey12345678901234567890" 
  },
  "AllowedHosts": "*"
}